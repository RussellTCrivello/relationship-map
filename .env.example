HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://relationship_map:change_me@127.0.0.1:5432/relationship_map
NODE_ENV=production
# Used by docker compose for the database container (keep in sync with DATABASE_URL)
POSTGRES_PASSWORD=change_me

# Administrator account (created on first start). If ADMIN_PASSWORD is empty a random password is
# generated and printed once on the server console. Change it from the account menu after logging in.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
